{
  "entities": {
    "ChatMessage": {
      "title": "Chat Message",
      "description": "Represents a message sent in global chat or channel",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "text": { "type": "string" },
        "sender": { "type": "string" },
        "avatar": { "type": "string" },
        "timestamp": { "type": "number" },
        "attachments": { "type": "array" }
      },
      "required": ["id", "text", "sender", "timestamp"]
    },
    "UserPresence": {
      "title": "User Presence",
      "description": "Tracks active online users and profile information",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "name": { "type": "string" },
        "avatar": { "type": "string" },
        "lastSeen": { "type": "number" },
        "status": { "type": "string" }
      },
      "required": ["uid", "name", "lastSeen"]
    },
    "VoiceUser": {
      "title": "Voice User",
      "description": "Tracks users connected in voice channels",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "name": { "type": "string" },
        "avatar": { "type": "string" },
        "isMuted": { "type": "boolean" },
        "isDeafened": { "type": "boolean" },
        "isScreenSharing": { "type": "boolean" },
        "joinedAt": { "type": "number" }
      },
      "required": ["uid", "name"]
    },
    "WebRTCSignal": {
      "title": "WebRTC Signal",
      "description": "WebRTC signaling messages between peer connections",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "uid": { "type": "string" },
        "targetUid": { "type": "string" },
        "type": { "type": "string" },
        "sdp": { "type": "string" },
        "candidate": { "type": "string" },
        "timestamp": { "type": "number" }
      },
      "required": ["uid", "targetUid", "type"]
    }
  },
  "firestore": {
    "/messages/{messageId}": {
      "schema": "ChatMessage",
      "description": "Global chat messages collection"
    },
    "/presence/{userId}": {
      "schema": "UserPresence",
      "description": "Online presence records"
    },
    "/voice_users/{userId}": {
      "schema": "VoiceUser",
      "description": "Voice channel participant list"
    },
    "/signals/{signalId}": {
      "schema": "WebRTCSignal",
      "description": "WebRTC peer signaling channel"
    }
  }
}
